---
import { Icon } from '@astrojs/starlight/components';

const { entry, editUrl } = Astro.locals.starlightRoute;
const href = editUrl
	? `/suggest/?${new URLSearchParams({
			page: Astro.url.pathname,
			title: entry.data.title,
			file: entry.filePath,
		})}`
	: undefined;
---

{
	href && (
		<a href={href} class="sl-flex print:hidden">
			<Icon name="pencil" size="1.2em" />
			Suggest a change
		</a>
	)
}

<style>
	@layer starlight.core {
		a {
			gap: 0.5rem;
			align-items: center;
			text-decoration: none;
			color: var(--sl-color-gray-3);
		}
		a:hover {
			color: var(--sl-color-white);
		}
	}
</style>
